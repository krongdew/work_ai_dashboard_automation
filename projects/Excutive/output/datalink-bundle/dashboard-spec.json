{
  "dashboard_title": "Executive Overview Dashboard",
  "renderer": "executive-overview",
  "purpose": "ติดตามภาพรวมการศึกษา วิเทศน์ วิจัย บุคลากร และการลงทุนจากข้อมูลที่ผ่านการตรวจสอบแล้ว",
  "audience": "ผู้บริหารคณะ",
  "display_labels": {
    "dashboard_section": "มุมมอง",
    "record_type": "ประเภทระเบียน",
    "education_level": "ระดับการศึกษา",
    "program": "หลักสูตร",
    "entry_year": "ปีที่เข้าศึกษา",
    "entry_month": "เดือนที่เข้าศึกษา",
    "entry_fiscal_year": "ปีงบประมาณที่เข้า",
    "study_year": "ชั้นปี",
    "student_status": "สถานภาพนักศึกษา",
    "direction": "ทิศทาง",
    "academic_year": "ปีการศึกษา",
    "country": "ประเทศ",
    "university": "มหาวิทยาลัยคู่ความร่วมมือ",
    "year": "ปี",
    "type": "ประเภทผลงาน",
    "journal": "วารสาร",
    "status": "สถานะบุคลากร",
    "position": "ตำแหน่ง",
    "work_line": "สายงาน",
    "report_date": "วันที่รายงาน",
    "net_asset_value": "มูลค่าทรัพย์สินสุทธิ",
    "period_return": "ผลตอบแทนช่วงรายงาน"
  },
  "tabs": [
    {
      "key": "education",
      "label": "การศึกษา",
      "fixed_filters": {
        "dashboard_section": [
          "education"
        ]
      },
      "filters": [
        "record_type",
        "education_level",
        "entry_year",
        "entry_month",
        "entry_fiscal_year",
        "study_year"
      ],
      "kpis": [
        {
          "name": "จำนวนระเบียนการศึกษา",
          "metric": "record_count",
          "aggregation": "count",
          "formula": "COUNT(*)"
        }
      ],
      "charts": [
        {
          "title": "ระเบียนตามระดับการศึกษา",
          "type": "bar",
          "dimension": "education_level",
          "metric": "record_count",
          "aggregation": "count",
          "formula": "COUNT(*)"
        }
      ]
    },
    {
      "key": "mobility",
      "label": "วิเทศน์",
      "fixed_filters": {
        "dashboard_section": [
          "mobility"
        ]
      },
      "filters": [
        "academic_year",
        "month",
        "direction",
        "country"
      ],
      "kpis": [
        {
          "name": "จำนวนระเบียน mobility",
          "metric": "record_count",
          "aggregation": "count",
          "formula": "COUNT(*)"
        }
      ],
      "charts": [
        {
          "title": "Mobility ตามประเทศ",
          "type": "bar",
          "dimension": "country",
          "metric": "record_count",
          "aggregation": "count",
          "formula": "COUNT(*)"
        }
      ]
    },
    {
      "key": "research",
      "label": "วิจัย",
      "fixed_filters": {
        "dashboard_section": [
          "research"
        ]
      },
      "filters": [
        "year",
        "type",
        "journal"
      ],
      "kpis": [
        {
          "name": "ผลงานวิจัย",
          "metric": "record_count",
          "aggregation": "count",
          "formula": "COUNT(*)"
        }
      ],
      "charts": [
        {
          "title": "ผลงานตามประเภท",
          "type": "bar",
          "dimension": "type",
          "metric": "record_count",
          "aggregation": "count",
          "formula": "COUNT(*)"
        }
      ]
    },
    {
      "key": "personnel",
      "label": "บุคลากร",
      "fixed_filters": {
        "dashboard_section": [
          "personnel"
        ]
      },
      "filters": [
        "status",
        "work_line",
        "position"
      ],
      "kpis": [
        {
          "name": "จำนวนบุคลากร",
          "metric": "record_count",
          "aggregation": "count",
          "formula": "COUNT(*)"
        }
      ],
      "charts": [
        {
          "title": "บุคลากรตามสายงาน",
          "type": "bar",
          "dimension": "work_line",
          "metric": "record_count",
          "aggregation": "count",
          "formula": "COUNT(*)"
        }
      ]
    },
    {
      "key": "investment",
      "label": "การลงทุน",
      "fixed_filters": {
        "dashboard_section": [
          "investment"
        ]
      },
      "filters": [
        "year",
        "month"
      ],
      "kpis": [
        {
          "name": "มูลค่าทรัพย์สินสุทธิ",
          "metric": "net_asset_value",
          "aggregation": "sum",
          "formula": "SUM(net_asset_value)"
        }
      ],
      "charts": [
        {
          "title": "มูลค่าทรัพย์สินสุทธิตามช่วงรายงาน",
          "type": "line",
          "dimension": "report_date",
          "metric": "net_asset_value",
          "aggregation": "sum",
          "formula": "SUM(net_asset_value)"
        }
      ]
    }
  ]
}
